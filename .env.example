# =========================================================
# CyREN environment configuration
# Copy this file to ".env" and fill in your own values.
# Never commit the real .env (or .env.enc) file.
# =========================================================

# ---- Flask ----
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///data/cyren.db
# minutes of inactivity before the browser session is logged out
IDLE_TIMEOUT_MINUTES=30

# ---- Secrets at rest (optional) ----
# `python scripts/encrypt_env.py` encrypts this file into .env.enc using a
# Fernet key read from the CYREN_SECRET_KEY *OS environment variable* (not from
# this file). On start-up CyREN decrypts .env.enc in memory when that variable
# is set, otherwise it falls back to the plain .env.

# ---- ELK / Elasticsearch ----
# The ELK stack runs in Docker on the same machine as CyREN (docker-elk).
# Target VM: Filebeat -> Logstash :5044 -> Elasticsearch :9200 -> Kibana :5601
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTIC_ALERT_INDEX=.alerts-security.alerts-default
FILEBEAT_INDEX=filebeat*
KIBANA_RULES_INDEX=.kibana_alerting_cases*
# max raw log documents fetched per poll
FILEBEAT_MAX_DOCS=3000

# Ingest mode: filebeat (match rule queries against raw logs, default) |
# alerts (read Kibana alert index) | both
INGEST_MODE=filebeat
# How far back each poll looks. Lab alerts come in bursts, so a short window
# goes empty between sessions; 168h = 7 days keeps an experiment in view.
FETCH_WINDOW_HOURS=168
# hours of silence before activity from the same source counts as a new session
SESSION_GAP_HOURS=6

# Source IPs to treat as noise, not attackers (dropped before an event is
# created). Comma-separated single IPs or CIDR ranges. Loopback + the
# VirtualBox host-only gateway (the host machine) by default.
SOURCE_IP_BLACKLIST=127.0.0.0/8,::1,192.168.56.1

# ---- Background pipeline scheduler ----
# true = poll Elasticsearch and run the pipeline automatically
ENABLE_SCHEDULER=false
POLL_INTERVAL_SECONDS=15

# ---- Triage: XGBoost ----
XGBOOST_MODEL_PATH=data/models/triage_xgb.json
RULE_MAP_PATH=data/models/rule_map.json
# Routing thresholds (confidence 0.0 - 1.0); a manager can also change them
# live from the Settings page
HIGH_RISK_THRESHOLD=0.85
LOW_RISK_THRESHOLD=0.40

# ---- Investigation: LLM ----
# ollama = local model served by Ollama (used by this project, no cloud, no quota)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# keep the model loaded between calls
OLLAMA_KEEP_ALIVE=30m
# Optional alternative: a hosted Groq model (LLM_PROVIDER=groq). Not used here.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=500

# ---- Investigation: MITRE ATT&CK knowledge base (ChromaDB + Gemini embeddings) ----
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=mitre_attack
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBED_MODEL=models/text-embedding-004

# ---- Response: containment ----
# Blocking is enforced on the target VM by deploy/target-agent, which pulls the
# read-only /api/blocklist feed every 10 s and applies it with ipset. The agent
# must present this token (generate a long random string and copy it into the
# agent's blocklist.conf).
BLOCKLIST_TOKEN=generate-a-long-random-token
# Legacy direct-iptables mode on the CyREN host itself. Keep false.
ENABLE_IPTABLES=false
IPTABLES_CHAIN=CYREN_BLOCK

# ---- Email notification (optional; leave blank to disable) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=soc-team@company.com
# Base URL of the CyREN web app; used for the 'open in CyREN' link in alert emails
APP_BASE_URL=http://localhost:5000

# ---- Reports ----
REPORT_OUTPUT_DIR=data/reports

# ---- Threat Intelligence (public IPs only; private IPs use the local feed) ----
# Leave blank to disable the external lookups.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
MISP_URL=
MISP_API_KEY=
